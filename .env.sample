# ==============================================================================
# Azion Console Kit — environment template
#
# Copy to .env and adjust. Everything here is OPTIONAL for `yarn dev`:
# the app boots without any of it (features that need a value degrade
# gracefully and log a warning).
#
#   cp .env.sample .env
#
# In deployed environments (stage/production) these values are NOT baked into
# the bundle: the deploy pipeline injects a /config.json read at runtime
# (see src/helpers/runtime-config.js and scripts/generate-runtime-config.js).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) CORE — which backend environment the app targets
#    'development' | 'stage' | 'production'  (default: vite MODE)
# ------------------------------------------------------------------------------
VITE_ENVIRONMENT=stage

# ------------------------------------------------------------------------------
# 2) PUBLIC CLIENT-SIDE VALUES (runtime bucket)
#    Public tokens/ids only — in deploys they come from /config.json.
#    Fill locally only if you need the specific feature.
# ------------------------------------------------------------------------------
# Sentry DSN for error reporting (per environment)
# VITE_STAGE_SENTRY=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_PROD_SENTRY=https://examplePublicKey@o0.ingest.sentry.io/0

# Stripe publishable key (billing screens). Runtime key: stripeToken
# VITE_STRIPE_TOKEN_DEV=pk_test_yourDevKeyHere
# VITE_STRIPE_TOKEN_STAGE=pk_test_yourStageKeyHere
# VITE_STRIPE_TOKEN_PROD=pk_live_yourProdKeyHere

# reCAPTCHA v3 site key (signup/login forms)
# VITE_RECAPTCHA_SITE_KEY=yourRecaptchaSiteKeyHere

# Segment write key (product analytics)
# VITE_SEGMENT_TOKEN=yourSegmentWriteKeyHere

# SSO provider application ids (login/signup social buttons)
# VITE_SSO_GITHUB=00000000-0000-0000-0000-000000000000
# VITE_SSO_GOOGLE=00000000-0000-0000-0000-000000000000
# VITE_SSO_AZURE=00000000-0000-0000-0000-000000000000
# VITE_SSO_IDP_SCIM_E2E=00000000-0000-0000-0000-000000000000

# AppCues account id (in-product guides)
# VITE_APPCUES_ACCOUNT_ID=00000

# HubSpot proxy base URL (marketing form events)
# VITE_HUBSPOT_API_URL=https://www.azion.com/api

# ------------------------------------------------------------------------------
# 3) BUILD-ONLY (CI secrets — never in .env of a shared machine,
#    never in config.json; used only for source-map upload at build time)
# ------------------------------------------------------------------------------
# VITE_SENTRY_UPLOAD=false
# VITE_SENTRY_AUTH_TOKEN=
# VITE_SENTRY_ORG=your-sentry-org
# VITE_SENTRY_PROJECT=your-sentry-project

# ------------------------------------------------------------------------------
# 4) LOCAL-DEV ONLY (convenience switches — NEVER deploy these values;
#    they are personal credentials / debug bypasses)
# ------------------------------------------------------------------------------
# Skip the login screen using a personal token (get one in Console)
# VITE_DEBUG_LOGIN=true
# VITE_PERSONAL_TOKEN=yourPersonalTokenHere

# Log dev-server proxy activity
# VITE_DEBUG_PROXY=true

# AppCues API basic-auth pair (only for local Appcues API exploration)
# VITE_APPCUES_API_KEY=
# VITE_APPCUES_SECRET=

# Beholder SSE endpoint override (real-time events)
# VITE_BEHOLDER_URL=
